<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System Terminal</title>
    <style>
        body {
            background-color: #050505;
            color: #00ff00;
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        #terminal {
            width: 80%;
            max-width: 800px;
            height: 400px;
            background-color: rgba(0, 0, 0, 0.9);
            border: 1px solid #00ff00;
            padding: 20px;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);
            overflow-y: auto;
            border-radius: 5px;
        }

        .line {
            margin: 5px 0;
            white-space: pre-wrap;
            opacity: 0;
            animation: fadeIn 0.3s forwards;
        }

        .danger-line {
            color: #ff0000;
            font-weight: bold;
        }

        #final-screen {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: #000;
            color: #ff0000;
            text-align: center;
            justify-content: center;
            align-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            text-shadow: 0 0 15px #ff0000;
            z-index: 9999;
            animation: glitch 1s infinite;
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        @keyframes glitch {
            0% { transform: translate(0) }
            20% { transform: translate(-2px, 2px) }
            40% { transform: translate(-2px, -2px) }
            60% { transform: translate(2px, 2px) }
            80% { transform: translate(2px, -2px) }
            100% { transform: translate(0) }
        }
    </style>
</head>
<body>

    <div id="terminal"></div>

    <div id="final-screen">
        ☠️ تم اختراق جهازك من قبل الخال اللل ☠️
    </div>

    <script>
        const terminal = document.getElementById('terminal');
        const finalScreen = document.getElementById('final-screen');

        // الأسطر الوهمية التي ستظهر بالتتابع
        const logs = [
            "Connecting to root server...",
            "Bypassing firewall [OK]",
            "Injecting payload package...",
            "Extracting system credentials...",
            "Downloading local database...",
            "CRITICAL: Security breach successful.",
            "Clearing system event logs...",
            "Disconnecting trace routes..."
        ];

        let currentLine = 0;

        function typeLog() {
            if (currentLine < logs.length) {
                const p = document.createElement('p');
                p.className = 'line';
                
                // تلوين الأسطر الخطيرة باللون الأحمر
                if (logs[currentLine].includes("CRITICAL") || logs[currentLine].includes("breach")) {
                    p.classList.add('danger-line');
                }
                
                p.textContent = `> ${logs[currentLine]}`;
                terminal.appendChild(p);
                terminal.scrollTop = terminal.scrollHeight;
                
                currentLine++;
                // سرعة عشوائية لظهور الأسطر لمنح طابع حقيقي
                setTimeout(typeLog, Math.random() * 600 + 400); 
            } else {
                // الانتظار قليلاً بعد انتهاء الأسطر ثم عرض شاشة الاختراق الوهمية
                setTimeout(() => {
                    finalScreen.style.display = 'grid';
                }, 1000);
            }
        }

        // بدء المحاكاة الوهمية
        setTimeout(typeLog, 500);
    </script>
</body>
</html>

